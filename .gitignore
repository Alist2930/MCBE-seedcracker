# Prebuilt per-platform libraries are shipped in the repo so users do not
# need to compile; bare-name .so/.dll (older local builds) stay ignored
!MCBEseedcracker_cli/crack_low32/crack_low32_*_*.so
!MCBEseedcracker_cli/crack_low32/crack_low32_opencl_*_*.so
!MCBEseedcracker_cli/crack_high32/crack_high32_*_*.so
