# Compiled files
*.o
*.a
*.obj
*.lib

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/
.trae/
*.swp
*.swo
*~
.claude/

# OS
.DS_Store
Thumbs.db

# Test files
test_*.py
verify_*.py
check_*.py
biomes_zh.txt
get_biome.py
measure_biome_rarity.py
!core/check_cpu.py

# Documentation (root level)
UI_DEVELOPMENT_PLAN.md

# Ignore Windows non-UI version (MCBEseedcracker/)
MCBEseedcracker/

# Session and config files
session_data.json
config.json
progress_*.json

# Build artifacts
*.spec
!gui/build.spec

# Native build artifacts: locally built bare-name libs stay untracked; the
# prebuilt per-platform libraries shipped in core/native are whitelisted so
# users never need to compile
core/native/*
!core/native/crack_low32_win_x86_64.dll
!core/native/crack_low32_opencl_win_x86_64.dll
!core/native/crack_high32_win_x86_64.dll
!core/native/crack_low32_linux_x86_64.so
!core/native/crack_low32_opencl_linux_x86_64.so
!core/native/crack_high32_linux_x86_64.so
!core/native/crack_low32_macos_arm64.so
!core/native/crack_low32_opencl_macos_arm64.so
!core/native/crack_high32_macos_arm64.so
!core/native/crack_low32.cl

# CLI runtime output
**/found_seeds.txt

# Docs are local-only except the README template toolchain (source of the
# 6 READMEs). Nested rules: docs/* would otherwise block re-inclusion of the
# subdirectory, and the sub-level whitelist keeps legacy one-off scripts and
# __pycache__ out of the repo.
docs/*
